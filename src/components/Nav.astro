---
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}#work`, label: 'Work' },
  { href: `${base}#experience`, label: 'Experience' },
  { href: `${base}#open-source`, label: 'Open source' },
  { href: `${base}#about`, label: 'About' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b hairline" style="background: color-mix(in oklab, var(--color-bg) 94%, transparent); backdrop-filter: blur(10px);">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4" aria-label="Primary">
    <a href={base} class="text-[15px] font-semibold tracking-tight text-ink no-underline">Jaylon Malone</a>

    <div class="hidden items-center gap-6 md:flex">
      {links.map((link) => (
        <a href={link.href} class="text-sm text-ink-soft no-underline transition-colors hover:text-ink">{link.label}</a>
      ))}
      <a href={`${base}JaylonMalone_Resume.pdf`} class="text-sm font-medium text-ink no-underline">Resume</a>
      <a href={`${base}#contact`} class="border-l pl-6 text-sm font-medium text-brand no-underline hairline">Contact</a>
    </div>

    <button id="nav-toggle" type="button" class="flex h-11 w-11 items-center justify-center border text-ink md:hidden hairline" aria-expanded="false" aria-controls="nav-mobile" aria-label="Open menu">
      <svg width="19" height="19" viewBox="0 0 19 19" fill="none" aria-hidden="true">
        <path d="M2.5 5h14M2.5 9.5h14M2.5 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <div id="nav-mobile" hidden class="border-t px-6 py-4 md:hidden hairline" style="background: var(--color-bg);">
    <ul class="m-0 flex list-none flex-col p-0">
      {links.map((link) => (
        <li><a href={link.href} class="block py-3 text-[15px] text-ink-soft no-underline">{link.label}</a></li>
      ))}
      <li><a href={`${base}JaylonMalone_Resume.pdf`} class="block py-3 text-[15px] text-ink no-underline">Resume</a></li>
      <li><a href={`${base}#contact`} class="block py-3 text-[15px] font-medium text-brand no-underline">Contact</a></li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-mobile');
  if (btn && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    btn.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>
