---
import { DIAGRAMS } from '../lib/diagrams';

interface Props { id: string; }
const { id } = Astro.props;
const d = DIAGRAMS[id];
---

{d && (
  <figure class="my-10 border-y py-7 hairline">
    <ol class="m-0 flex list-none flex-col gap-0 p-0">
      {d.layers.map((layer, index) => (
        <li class="grid gap-3 py-4 md:grid-cols-[130px_1fr] md:gap-6">
          <div class="font-mono text-[10.5px] uppercase tracking-[0.08em] text-ink-faint">{layer.rail ?? `Layer ${index + 1}`}</div>
          <div class="flex flex-wrap gap-x-6 gap-y-3">
            {layer.nodes.map((node) => (
              <div class="min-w-[150px] flex-1 border-l pl-3 hairline">
                <div class="text-[13.5px] font-medium text-ink">{node.label}</div>
                {node.note && <div class="mt-1 font-mono text-[10.5px] leading-relaxed text-ink-mute">{node.note}</div>}
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>
    <figcaption class="mt-4 max-w-3xl text-[13px] leading-relaxed text-ink-mute">{d.caption}</figcaption>
  </figure>
)}
