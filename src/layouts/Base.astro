---
import '../styles/global.css';
import headshot from '../assets/jaylon-malone.jpg';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Jaylon Malone · Application Developer and Software Engineer',
  description =
    'Jaylon Malone builds production applications, APIs, automation, AI systems, and cross-device software.',
  ogImage,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const shareCard = new URL(
  ogImage ? base + ogImage.replace(/^\//, '') : `${base}og.png`,
  Astro.site
).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jaylon Malone',
  jobTitle: 'Application Developer and Software Engineer',
  image: new URL(headshot.src, Astro.site).href,
  url: new URL(base, Astro.site).href,
  email: 'mailto:jaylon@flashaisolutions.org',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mobile',
    addressRegion: 'AL',
    addressCountry: 'US',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of South Alabama',
  },
  sameAs: [
    'https://github.com/iFan6oy',
    'https://linkedin.com/in/jaylon-malone',
  ],
  knowsAbout: [
    'TypeScript', 'Python', 'Kotlin', 'C#', 'SQL', 'API design',
    'Model Context Protocol', 'Distributed systems', 'React Native',
    'Jetpack Compose', 'Power Platform',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jaylon Malone" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Jaylon Malone" />
    <meta property="og:image" content={shareCard} />
    <meta property="og:image:alt" content="Jaylon Malone, application developer and software engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareCard} />
    <meta name="theme-color" content="#0b0b0c" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      const els = document.querySelectorAll('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
