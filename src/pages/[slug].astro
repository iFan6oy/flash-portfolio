---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import { CATEGORY } from '../lib/categories';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const base = import.meta.env.BASE_URL;
const { project } = Astro.props;
const d = project.data;
const c = CATEGORY[d.category];
const { Content } = await render(project);
const asset = (path: string) => base + path.replace(/^\//, '');

// Plain-English story first (overview, at a glance, screenshots, context),
// then the engineering evidence for readers who want it.
const hasEngineering = d.engineering.length > 0 || !!d.architecture || !!d.diagram || d.decisions.length > 0 || d.hardProblems.length > 0;
const hasStory = !!d.problem || d.constraints.length > 0 || hasEngineering || d.result.length > 0;

const allProjects = await getCollection('projects');
const related = d.related.filter((r) => allProjects.some((p) => p.id === r.slug));

// Section numbers are counted at render time so a skipped section never leaves
// a gap like 01, 02, 05.
let n = 0;
const num = () => String(++n).padStart(2, '0');
const sourceLabel = d.private ? 'Private implementation' : d.links.repo ? 'Public repository' : 'Not published';
---

<Base title={`${d.title}, case study | Jaylon Malone`} description={d.description ?? d.tagline} ogImage={d.cover}>
  <Nav />
  <main id="main">
    <header class="mx-auto max-w-5xl px-6 pb-12 pt-32 md:pb-16 md:pt-40">
      <a href={`${base}#work`} class="text-sm text-ink-mute no-underline hover:text-ink">← All work</a>
      <p class="section-kicker mt-10">{c.label}</p>
      {d.logo && (
        <Image
          src={d.logo}
          alt={`${d.title} logo`}
          height={56}
          densities={d.logo.format === 'svg' ? undefined : [1, 2]}
          loading="eager"
          class="mt-6 block h-14 w-auto"
        />
      )}
      <h1 class="mt-4 max-w-4xl text-[clamp(2.8rem,7vw,5.2rem)] font-semibold leading-[0.98] text-ink">{d.title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink-soft md:text-xl">{d.tagline}</p>

      <dl class="mt-9 grid grid-cols-2 gap-x-10 gap-y-5 border-y py-5 hairline md:grid-cols-4">
        <div>
          <dt class="text-xs text-ink-faint">Role</dt>
          <dd class="mt-1 text-sm text-ink">{d.role}</dd>
        </div>
        <div>
          <dt class="text-xs text-ink-faint">Period</dt>
          <dd class="mt-1 text-sm text-ink">{d.year}</dd>
        </div>
        <div>
          <dt class="text-xs text-ink-faint">Status</dt>
          <dd class="mt-1 text-sm text-ink">{d.status}</dd>
        </div>
        <div>
          <dt class="text-xs text-ink-faint">Source</dt>
          <dd class="mt-1 text-sm text-ink">{sourceLabel}</dd>
        </div>
      </dl>

      {(d.links.live || d.links.repo || d.links.docs) && (
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-sm">
          {d.links.live && <a class="rule-link" href={d.links.live}>Live site</a>}
          {d.links.repo && <a class="rule-link" href={d.links.repo}>{d.links.repoLabel ?? 'View repository'}</a>}
          {d.links.docs && <a class="rule-link" href={d.links.docs}>Documentation</a>}
        </div>
      )}
    </header>

    {d.cover && (
      <figure class="mx-auto max-w-6xl px-6">
        <div class="overflow-hidden border hairline" style="background: var(--color-bg-1);">
          <img src={asset(d.cover)} alt={`${d.title} interface`} loading="eager" decoding="async" class="block h-auto w-full" />
        </div>
      </figure>
    )}

    <article class="mx-auto max-w-4xl px-6 py-14 md:py-20">
      {d.overview && (
        <section>
          <h2 class="section-kicker">In plain terms</h2>
          <p class="mt-5 text-lg leading-[1.75] text-ink md:text-[19px]">{d.overview}</p>
        </section>
      )}

      {d.highlights.length > 0 && (
        <section class={`${d.overview ? 'mt-12 ' : ''}border-y py-7 hairline`}>
          <h2 class="section-kicker">At a glance</h2>
          <ul class="mt-5 m-0 grid list-none gap-x-8 gap-y-4 p-0 sm:grid-cols-2">
            {d.highlights.map((item) => (
              <li class="border-l pl-4 text-sm leading-relaxed text-ink-soft hairline">{item}</li>
            ))}
          </ul>
        </section>
      )}

      {d.screenshots.length > 0 && (
        <section class="mt-14 space-y-10" aria-label="Product screenshots">
          {d.screenshots.map((shot, index) => (
            <figure class="mx-0">
              <div class="overflow-hidden border hairline" style="background: var(--color-bg-1);">
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  widths={[640, 960, 1440]}
                  sizes="(min-width: 896px) 848px, calc(100vw - 48px)"
                  loading={index === 0 && !d.cover ? 'eager' : 'lazy'}
                  class="block h-auto w-full"
                />
              </div>
              {shot.caption && <figcaption class="mt-3 text-[13px] leading-relaxed text-ink-mute">{shot.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      {hasStory && (
        <div class="mt-14 space-y-16">
          {d.problem && (
            <section>
              <p class="section-kicker">{num()} / Context</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">Why it exists</h2>
              <p class="mt-5 text-[17px] leading-[1.8] text-ink-soft">{d.problem}</p>
            </section>
          )}

          {d.constraints.length > 0 && (
            <section>
              <p class="section-kicker">{num()} / Constraints</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">What made it hard</h2>
              <ul class="mt-6 m-0 list-none border-t p-0 hairline">
                {d.constraints.map((item) => (
                  <li class="border-b py-4 leading-relaxed text-ink-soft hairline">{item}</li>
                ))}
              </ul>
            </section>
          )}

          {hasEngineering && (
            <p class="border-t pt-10 text-sm leading-relaxed text-ink-mute hairline">
              Engineering detail follows: the architecture, the decisions behind it, and the problems that took real debugging.
            </p>
          )}

          {hasEngineering && (
            <section>
              <p class="section-kicker">{num()} / Under the hood</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">Technical highlights</h2>
              {d.engineering.length > 0 && (
                <ul class="mt-6 m-0 list-none border-t p-0 hairline">
                  {d.engineering.map((item) => (
                    <li class="border-b py-4 leading-relaxed text-ink-soft hairline">{item}</li>
                  ))}
                </ul>
              )}
              {d.stack.length > 0 && (
                <p class="mt-5 text-sm leading-relaxed text-ink-mute"><span class="text-ink-faint">Built with: </span>{d.stack.join(' · ')}</p>
              )}
            </section>
          )}

          {(d.architecture || d.diagram) && (
            <section>
              <p class="section-kicker">{num()} / Architecture</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">How the system is put together</h2>
              {d.architecture && <p class="mt-5 text-[17px] leading-[1.8] text-ink-soft">{d.architecture}</p>}
              {d.diagram && <FlowDiagram id={d.diagram} />}
            </section>
          )}

          {d.decisions.length > 0 && (
            <section>
              <p class="section-kicker">{num()} / Decisions</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">Engineering decisions</h2>
              <div class="mt-7 border-t hairline">
                {d.decisions.map((item) => (
                  <div class="grid gap-3 border-b py-6 hairline md:grid-cols-[220px_1fr] md:gap-8">
                    <h3 class="text-base font-semibold leading-snug text-ink">{item.title}</h3>
                    <p class="leading-relaxed text-ink-soft">{item.body}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {d.hardProblems.length > 0 && (
            <section>
              <p class="section-kicker">{num()} / Deep dives</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">Problems that required real debugging</h2>
              <div class="mt-7 space-y-9">
                {d.hardProblems.map((item) => (
                  <div class="border-l pl-5 hairline">
                    <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
                    <p class="mt-3 leading-relaxed text-ink-soft">{item.body}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {d.result.length > 0 && (
            <section>
              <p class="section-kicker">{num()} / Current state</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">Where it stands</h2>
              <ul class="mt-6 m-0 list-none border-t p-0 hairline">
                {d.result.map((item) => (
                  <li class="border-b py-4 leading-relaxed text-ink-soft hairline">{item}</li>
                ))}
              </ul>
            </section>
          )}
        </div>
      )}

      {!hasEngineering && d.stack.length > 0 && (
        <p class="mt-12 text-sm leading-relaxed text-ink-mute"><span class="text-ink-faint">Built with: </span>{d.stack.join(' · ')}</p>
      )}

      <div class={`prose-case ${hasStory ? 'mt-16 border-t pt-10 hairline' : 'mt-10'}`}>
        <Content />
      </div>

      {related.length > 0 && (
        <nav class="mt-14 border-t pt-8 hairline" aria-label="Related case studies">
          <p class="section-kicker">Related</p>
          <ul class="mt-4 m-0 list-none space-y-3 p-0">
            {related.map((r) => (
              <li><a class="rule-link" href={`${base}${r.slug}/`}>{r.label}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="mt-16 border-t pt-8 hairline">
        <a href={`${base}#work`} class="rule-link text-sm">Back to all work</a>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style is:global>
  .prose-case { color: var(--color-ink-soft); line-height: 1.8; }
  .prose-case > * + * { margin-top: 1.15rem; }
  .prose-case h2 { margin-top: 2.5rem; color: var(--color-ink); font-size: 1.6rem; font-weight: 600; }
  .prose-case h3 { margin-top: 2rem; color: var(--color-ink); font-size: 1.2rem; font-weight: 600; }
  .prose-case strong { color: var(--color-ink); font-weight: 600; }
  .prose-case a { color: var(--color-brand); }
  .prose-case ul, .prose-case ol { padding-left: 1.2rem; }
  .prose-case li + li { margin-top: .45rem; }
  .prose-case blockquote { margin-left: 0; border-left: 2px solid var(--color-border-bright); padding-left: 1rem; color: var(--color-ink-mute); }
  .prose-case code { font-family: var(--font-mono); font-size: .87em; background: var(--color-bg-2); padding: .12em .35em; }
</style>
