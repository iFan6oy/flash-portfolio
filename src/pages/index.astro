---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../assets/jaylon-malone.jpg';
import oddsHome from '../assets/screens/flash-odds-home.png';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { OSS } from '../lib/openSource';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => base + path.replace(/^\//, '');
const projects = await getCollection('projects');
const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const byId = (id: string) => projects.find((p) => p.id === id);

const flashpoint = byId('flashpoint');
const flashOdds = byId('flash-odds');
const flashProps = byId('flash-props');
const chalkline = byId('chalkline');
const supporting = projects.filter((p) => p.data.group === 'supporting').sort(byOrder);
const archive = projects.filter((p) => p.data.group === 'archive').sort(byOrder);

// What each paired project is evidence of, in one plain phrase.
const pairKicker: Record<string, string> = {
  'flash-props': 'APIs, data, and AI agents',
  chalkline: 'Practical AI product',
};

const experience = [
  {
    role: 'Founder & Engineer',
    org: 'Flash AI Solutions',
    when: '2026 to present',
    body: 'I design, build, deploy, and run my own software products end to end: Flashpoint, Flash Odds, the Flash Props API, and Chalkline, plus client automation work. That includes the unglamorous parts: billing, monitoring, deployment pipelines, and fixing what breaks in production.',
  },
  {
    role: 'Application Developer',
    org: 'Mobile County Public Schools',
    when: '2024 to 2026',
    body: 'Owned production workflow applications for a large public school district on Power Apps, Power Automate, SharePoint, and Power BI. The largest was the district travel reimbursement and voucher system, which I consolidated from three separate apps into one approval pipeline and supported while staff used it to get reimbursed. I also built discipline referral and equipment tracking applications and reporting dashboards.',
  },
  {
    role: 'Software Development Intern',
    org: 'Keesler Federal Credit Union',
    when: '2022 to 2023',
    body: 'Built UiPath automations for internal processes, wrote SQL reporting, created Power BI dashboards, and wrote PowerShell scripts that automated support tasks for internal teams.',
  },
];
---

<Base>
  <Nav />
  <main id="main">
    <section class="mx-auto max-w-6xl px-6 pb-20 pt-36 md:pb-28 md:pt-44">
      <p class="section-kicker">Jaylon Malone</p>
      <h1 class="mt-5 max-w-5xl text-[clamp(2.7rem,7vw,5.5rem)] font-semibold leading-[0.98] text-ink">
        Application Developer & Software Engineer
      </h1>
      <p class="mt-7 max-w-3xl text-lg leading-relaxed text-ink-soft md:text-xl">
        I build software people actually use: web apps, APIs, automation, AI-powered products, and apps that run across phones, PCs, and TVs. I design it, ship it, and keep it running in production.
      </p>
      <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a class="rule-link" href="#work">Selected work</a>
        <a class="text-ink-soft hover:text-ink" href={asset('JaylonMalone_Resume.pdf')}>Resume</a>
        <a class="text-ink-soft hover:text-ink" href="https://github.com/iFan6oy">GitHub</a>
        <a class="text-ink-soft hover:text-ink" href="mailto:jaylon@flashaisolutions.org">Email</a>
      </div>
      <p class="mt-16 max-w-4xl border-t pt-5 text-sm leading-relaxed text-ink-mute hairline">
        Previously an application developer at Mobile County Public Schools, building the workflow apps district staff used every day, and a software development intern at Keesler Federal Credit Union. B.S. in Computer Science, University of South Alabama.
      </p>
    </section>

    <section id="work" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <div class="mb-12 max-w-2xl">
          <p class="section-kicker">Selected work</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">Products I built and run</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">Four live products, each a different kind of engineering. Every case study starts with what the product does, then gets into how it works.</p>
        </div>

        {flashpoint && (
          <article class="reveal border-b pb-20 hairline">
            <div class="grid gap-9 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
              <div>
                <p class="section-kicker">Flagship · Cross-device product</p>
                <h3 class="mt-3 text-4xl font-semibold text-ink md:text-5xl">{flashpoint.data.title}</h3>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{flashpoint.data.tagline}</p>
                <div class="mt-7 grid max-w-2xl gap-4 sm:grid-cols-2">
                  {flashpoint.data.highlights.slice(0, 4).map((item) => (
                    <p class="border-l pl-4 text-sm leading-relaxed text-ink-soft hairline">{item}</p>
                  ))}
                </div>
                <div class="mt-8 flex flex-wrap gap-x-7 gap-y-3">
                  <a class="rule-link" href={`${base}${flashpoint.id}/`}>Read the case study</a>
                  <a class="text-sm text-ink-soft hover:text-ink" href={`${base}session-brain/`}>Deep dive: keeping four devices in sync</a>
                </div>
              </div>
              {flashpoint.data.cover && (
                <figure class="m-0">
                  <div class="overflow-hidden border hairline" style="background: var(--color-bg-1);">
                    <img src={asset(flashpoint.data.cover)} alt="Flashpoint on Fire TV: the home screen with remote focus on a Continue Watching card" width="1920" height="850" loading="eager" decoding="async" class="block h-auto w-full" />
                  </div>
                  <figcaption class="mt-3 text-xs text-ink-faint">Fire TV app, native Kotlin and Jetpack Compose.</figcaption>
                </figure>
              )}
            </div>
          </article>
        )}

        {flashOdds && (
          <article class="reveal border-b py-20 hairline">
            <div class="grid gap-9 lg:grid-cols-[.95fr_1.05fr] lg:items-start">
              <div class="lg:order-last">
                <p class="section-kicker">Web product · Frontend, data, and visualization</p>
                <h3 class="mt-3 text-4xl font-semibold text-ink md:text-5xl">{flashOdds.data.title}</h3>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{flashOdds.data.tagline}</p>
                <div class="mt-7 grid max-w-2xl gap-4 sm:grid-cols-2">
                  {flashOdds.data.highlights.slice(0, 4).map((item) => (
                    <p class="border-l pl-4 text-sm leading-relaxed text-ink-soft hairline">{item}</p>
                  ))}
                </div>
                <div class="mt-8 flex flex-wrap gap-x-7 gap-y-3">
                  <a class="rule-link" href={`${base}${flashOdds.id}/`}>Read the case study</a>
                  {flashOdds.data.links.live && <a class="text-sm text-ink-soft hover:text-ink" href={flashOdds.data.links.live}>Visit flashodds.live</a>}
                </div>
              </div>
              <figure class="m-0">
                <div class="overflow-hidden border hairline" style="background: var(--color-bg-1);">
                  <Image
                    src={oddsHome}
                    alt="Flash Odds homepage with a featured NFL game comparing posted player lines to Flash projections, and a cross-sport player search"
                    widths={[640, 960, 1440]}
                    sizes="(min-width: 1024px) 540px, calc(100vw - 48px)"
                    loading="lazy"
                    class="block h-auto w-full"
                  />
                </div>
                <figcaption class="mt-3 text-xs text-ink-faint">Live site, captured September 2026.</figcaption>
              </figure>
            </div>
          </article>
        )}

        <div class="grid gap-0 md:grid-cols-2">
          {[flashProps, chalkline].filter(Boolean).map((project, index) => project && (
            <article class={`reveal py-14 ${index === 0 ? 'md:pr-10' : 'border-t md:border-l md:border-t-0 md:pl-10'} hairline`}>
              <p class="section-kicker">{pairKicker[project.id] ?? 'Selected project'}</p>
              {/* The slot is reserved whether or not a logo exists, so the two
                  columns keep their baselines aligned when only one has a mark. */}
              <div class="mt-5 flex h-10 items-center">
                {project.data.logo && (
                  <Image
                    src={project.data.logo}
                    alt={`${project.data.title} logo`}
                    height={40}
                    densities={project.data.logo.format === 'svg' ? undefined : [1, 2]}
                    loading="lazy"
                    class="block h-10 w-auto"
                  />
                )}
              </div>
              <h3 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">{project.data.title}</h3>
              <p class="mt-4 leading-relaxed text-ink-soft">{project.data.tagline}</p>
              <ul class="mt-6 m-0 list-none space-y-3 p-0">
                {project.data.highlights.slice(0, 3).map((item) => (
                  <li class="border-l pl-4 text-sm leading-relaxed text-ink-mute hairline">{item}</li>
                ))}
              </ul>
              <div class="mt-7 flex flex-wrap gap-x-7 gap-y-3">
                <a class="rule-link text-sm" href={`${base}${project.id}/`}>Read the case study</a>
                {project.data.links.live && <a class="text-sm text-ink-soft hover:text-ink" href={project.data.links.live}>Live product</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <div class="mb-10 max-w-2xl">
          <p class="section-kicker">Professional experience</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">Production work, not just portfolio work</h2>
        </div>
        <ol class="m-0 list-none p-0">
          {experience.map((item, index) => (
            <li class={`reveal grid gap-3 py-7 md:grid-cols-[180px_1fr] md:gap-10 ${index > 0 ? 'border-t hairline' : ''}`}>
              <div>
                <p class="font-mono text-[11px] text-ink-faint">{item.when}</p>
                <p class="mt-2 text-sm font-medium text-ink">{item.org}</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-ink">{item.role}</h3>
                <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft">{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-4 text-sm text-ink-mute">
          The district reimbursement system has its own write-up: <a class="text-brand" href={`${base}mcpss-travel-suite/`}>MCPSS Travel and Voucher Suite</a>.
        </p>
      </div>
    </section>

    <section id="more" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <div class="mb-8 max-w-2xl">
          <p class="section-kicker">More work</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">Different problems, same ownership</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">Smaller projects, each chosen because it shows a different skill.</p>
        </div>
        <div class="border-t hairline">
          {supporting.map((project) => (
            <a href={`${base}${project.id}/`} class="reveal group grid gap-2 border-b py-5 no-underline hairline md:grid-cols-[240px_1fr_auto] md:items-baseline md:gap-8">
              <span>
                <span class="block font-medium text-ink group-hover:text-brand">{project.data.title}</span>
                {project.data.capability && <span class="mt-1 block text-xs text-ink-faint">{project.data.capability}</span>}
              </span>
              <span class="text-sm leading-relaxed text-ink-mute">{project.data.tagline}</span>
              <span class="hidden text-sm text-ink-faint md:inline" aria-hidden="true">View →</span>
            </a>
          ))}
        </div>
        {archive.length > 0 && (
          <p class="mt-8 max-w-4xl text-sm leading-relaxed text-ink-mute">
            <span class="text-ink-faint">Other projects and earlier experiments: </span>
            {archive.map((project, index) => (
              <Fragment>
                <a class="text-ink-soft hover:text-ink" href={`${base}${project.id}/`}>{project.data.title}</a>{index < archive.length - 1 ? ', ' : '.'}
              </Fragment>
            ))}
          </p>
        )}
      </div>
    </section>

    <section id="open-source" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <div class="mb-10 max-w-3xl">
          <p class="section-kicker">Open source</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">Extracted from shipped work</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">Reusable pieces pulled out of the systems above, stripped of private infrastructure and data, and published so the claims on this page can be checked in code.</p>
        </div>
        <div class="border-t hairline">
          {OSS.map((repo) => (
            <a href={repo.repo} class="reveal group grid gap-2 border-b py-5 no-underline hairline md:grid-cols-[280px_1fr] md:gap-8">
              <span>
                <span class="block font-mono text-[13px] font-medium text-ink group-hover:text-brand">{repo.name}</span>
                <span class="mt-1 block text-xs text-ink-faint">{repo.lang}{repo.proves ? ` · from ${repo.proves}` : ''}</span>
              </span>
              <span class="text-sm leading-relaxed text-ink-mute">{repo.blurb}</span>
            </a>
          ))}
        </div>
        <a class="rule-link mt-8 text-sm" href="https://github.com/iFan6oy">Everything else on GitHub</a>
      </div>
    </section>

    <section id="about" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:py-24 lg:grid-cols-[1fr_.8fr]">
        <div class="reveal">
          <p class="section-kicker">About</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">I like owning systems end to end.</h2>
          <div class="mt-8 flex max-w-2xl flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
            <Image
              src={headshot}
              alt="Jaylon Malone"
              widths={[176, 352, 450]}
              sizes="(min-width: 640px) 176px, 160px"
              loading="lazy"
              class="w-40 shrink-0 rounded-xl border object-cover hairline sm:w-44"
            />
            <div class="space-y-4 leading-relaxed text-ink-soft">
              <p>I'm an application developer based in Mobile, Alabama, with a computer science degree and professional experience building business software that people depended on to do their jobs.</p>
              <p>Since going independent I've built my own products: a media platform that runs on four kinds of devices, a commercial sports data API, a consumer sports site, and a classroom tool for teachers. I care about the whole lifecycle: understanding the problem, building it, running it in production, and improving it from real use.</p>
            </div>
          </div>
        </div>
        <div id="contact" class="reveal scroll-mt-24 border-l pl-6 hairline lg:pl-10">
          <p class="section-kicker">Contact</p>
          <h2 class="mt-3 text-2xl font-semibold text-ink">Let's talk about the work.</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">For engineering roles, contract work, or technical collaboration, email is the fastest way to reach me.</p>
          <div class="mt-6 space-y-3 text-sm">
            <a class="block font-medium text-brand" href="mailto:jaylon@flashaisolutions.org">jaylon@flashaisolutions.org</a>
            <a class="block text-ink-soft" href="https://github.com/iFan6oy">GitHub</a>
            <a class="block text-ink-soft" href="https://www.linkedin.com/in/jaylon-malone-3b306b37/">LinkedIn</a>
            <a class="block text-ink-soft" href={asset('JaylonMalone_Resume.pdf')}>Resume (PDF)</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
