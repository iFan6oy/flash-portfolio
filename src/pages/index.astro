---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../assets/jaylon-malone.jpg';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import { OSS } from '../lib/openSource';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => base + path.replace(/^\//, '');
const projects = await getCollection('projects');
const byOrder = (a: any, b: any) => a.data.order - b.data.order;

const flashpoint = projects.find((p) => p.id === 'flashpoint');
const flashProps = projects.find((p) => p.id === 'flash-props');
const chalkline = projects.find((p) => p.id === 'chalkline');
const sessionBrain = projects.find((p) => p.id === 'session-brain');
const primaryIds = new Set(['flashpoint', 'flash-props', 'chalkline', 'session-brain']);
const more = projects.filter((p) => !primaryIds.has(p.id)).sort(byOrder);

const experience = [
  {
    role: 'Founder & Engineer',
    org: 'Flash AI Solutions',
    when: '2026 to present',
    body: 'Building and shipping independent software products, APIs, automation systems, and client work. Current systems include Flashpoint, Flash Props, Chalkline, and a growing set of production-derived open-source tools.',
  },
  {
    role: 'Application Developer',
    org: 'Mobile County Public Schools',
    when: '2024 to 2026',
    body: 'Owned production workflow software across Power Apps, Power Automate, SharePoint, and Power BI, including the district travel reimbursement and voucher platform and additional operational systems.',
  },
  {
    role: 'Software Development Intern',
    org: 'Keesler Federal Credit Union',
    when: '2022 to 2023',
    body: 'Built enterprise process automation with UiPath, backed by SQL reporting, Power BI dashboards, and PowerShell tooling for internal teams.',
  },
];
---

<Base>
  <Nav />
  <main id="main">
    <section class="mx-auto max-w-6xl px-6 pb-20 pt-36 md:pb-28 md:pt-44">
      <p class="section-kicker">Jaylon Malone</p>
      <h1 class="mt-5 max-w-5xl text-[clamp(2.7rem,7vw,5.5rem)] font-semibold leading-[0.98] text-ink">
        Application Developer & Software Engineer
      </h1>
      <p class="mt-7 max-w-3xl text-lg leading-relaxed text-ink-soft md:text-xl">
        I build production applications, APIs, automation, AI systems, and cross-device software. My work ranges from enterprise workflow systems to native TV clients and agent-facing data products.
      </p>
      <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a class="rule-link" href="#work">Selected work</a>
        <a class="text-ink-soft hover:text-ink" href={asset('JaylonMalone_Resume.pdf')}>Resume</a>
        <a class="text-ink-soft hover:text-ink" href="https://github.com/iFan6oy">GitHub</a>
        <a class="text-ink-soft hover:text-ink" href="mailto:jaylon@flashaisolutions.org">Email</a>
      </div>
      <p class="mt-16 border-t pt-5 text-sm text-ink-mute hairline">
        Professional experience includes application development for Mobile County Public Schools and software development and UiPath automation work at Keesler Federal Credit Union.
      </p>
    </section>

    <section id="work" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <div class="mb-12 max-w-2xl">
          <p class="section-kicker">Selected work</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">Systems worth inspecting</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">A small set of projects that best show how I design, build, and operate software end to end.</p>
        </div>

        {flashpoint && (
          <article class="reveal border-b pb-20 hairline">
            <div class="grid gap-9 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
              <div>
                <p class="section-kicker">Flagship project</p>
                <h3 class="mt-3 text-4xl font-semibold text-ink md:text-5xl">{flashpoint.data.title}</h3>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{flashpoint.data.tagline}</p>
                <div class="mt-7 grid max-w-2xl gap-4 sm:grid-cols-2">
                  {flashpoint.data.highlights.slice(0, 4).map((item) => (
                    <p class="border-l pl-4 text-sm leading-relaxed text-ink-soft hairline">{item}</p>
                  ))}
                </div>
                <a class="rule-link mt-8" href={`${base}${flashpoint.id}/`}>Read the case study</a>
              </div>
              {flashpoint.data.cover && (
                <figure class="overflow-hidden border hairline" style="background: var(--color-bg-1);">
                  <img src={asset(flashpoint.data.cover)} alt="Flashpoint desktop interface" loading="eager" decoding="async" class="block h-auto w-full" />
                </figure>
              )}
            </div>
          </article>
        )}

        <div class="grid gap-0 md:grid-cols-2">
          {[flashProps, chalkline].filter(Boolean).map((project, index) => project && (
            <article class={`reveal py-14 ${index === 0 ? 'md:pr-10' : 'border-t md:border-l md:border-t-0 md:pl-10'} hairline`}>
              <p class="section-kicker">Selected project</p>
              {/* The slot is reserved whether or not a logo exists, so the two
                  columns keep their baselines aligned when only one has a mark. */}
              <div class="mt-5 flex h-10 items-center">
                {project.data.logo && (
                  <Image
                    src={project.data.logo}
                    alt={`${project.data.title} logo`}
                    height={40}
                    densities={project.data.logo.format === 'svg' ? undefined : [1, 2]}
                    loading="lazy"
                    class="block h-10 w-auto"
                  />
                )}
              </div>
              <h3 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">{project.data.title}</h3>
              <p class="mt-4 leading-relaxed text-ink-soft">{project.data.tagline}</p>
              <ul class="mt-6 m-0 list-none space-y-3 p-0">
                {project.data.highlights.slice(0, 3).map((item) => (
                  <li class="text-sm leading-relaxed text-ink-mute">{item}</li>
                ))}
              </ul>
              <a class="rule-link mt-7 text-sm" href={`${base}${project.id}/`}>View project</a>
            </article>
          ))}
        </div>

        {sessionBrain && (
          <article class="reveal border-t pt-16 hairline">
            <div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
              <div>
                <p class="section-kicker">Distributed systems</p>
                <h3 class="mt-3 text-3xl font-semibold text-ink">{sessionBrain.data.title}</h3>
                <p class="mt-4 leading-relaxed text-ink-soft">{sessionBrain.data.tagline}</p>
                <a class="rule-link mt-7 text-sm" href={`${base}${sessionBrain.id}/`}>Read the architecture story</a>
              </div>
              {sessionBrain.data.diagram && <FlowDiagram id={sessionBrain.data.diagram} />}
            </div>
          </article>
        )}
      </div>
    </section>

    <section id="experience" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <div class="mb-10 max-w-2xl">
          <p class="section-kicker">Professional experience</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">Production work, not just portfolio work</h2>
        </div>
        <ol class="m-0 list-none p-0">
          {experience.map((item, index) => (
            <li class={`reveal grid gap-3 py-7 md:grid-cols-[180px_1fr] md:gap-10 ${index > 0 ? 'border-t hairline' : ''}`}>
              <div>
                <p class="font-mono text-[11px] text-ink-faint">{item.when}</p>
                <p class="mt-2 text-sm font-medium text-ink">{item.org}</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-ink">{item.role}</h3>
                <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft">{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-t hairline">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <div class="mb-8 max-w-2xl">
          <p class="section-kicker">More engineering</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">Additional systems and experiments</h2>
        </div>
        <div class="border-t hairline">
          {more.map((project) => (
            <a href={`${base}${project.id}/`} class="reveal group grid gap-3 border-b py-5 no-underline hairline md:grid-cols-[220px_1fr_auto] md:items-baseline md:gap-8">
              <span class="font-medium text-ink group-hover:text-brand">{project.data.title}</span>
              <span class="text-sm leading-relaxed text-ink-mute">{project.data.tagline}</span>
              <span class="text-sm text-ink-faint">View →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="open-source" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <div class="mb-10 max-w-3xl">
          <p class="section-kicker">Open source</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">Extracted, not invented</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">Reusable pieces pulled out of systems that shipped, then stripped of private infrastructure, branding, and data sources.</p>
        </div>
        <div class="border-t hairline">
          {OSS.map((repo) => (
            <a href={repo.repo} class="reveal group grid gap-2 border-b py-5 no-underline hairline md:grid-cols-[280px_100px_1fr] md:gap-6">
              <span class="font-mono text-[13px] font-medium text-ink group-hover:text-brand">{repo.name}</span>
              <span class="text-xs text-ink-faint">{repo.lang}</span>
              <span class="text-sm leading-relaxed text-ink-mute">{repo.blurb}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="scroll-mt-24 border-t hairline">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:py-24 lg:grid-cols-[1fr_.8fr]">
        <div class="reveal">
          <p class="section-kicker">About</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">I like owning systems end to end.</h2>
          <div class="mt-8 flex max-w-2xl flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
            <Image
              src={headshot}
              alt="Jaylon Malone"
              widths={[176, 352, 450]}
              sizes="(min-width: 640px) 176px, 160px"
              loading="lazy"
              class="w-40 shrink-0 rounded-xl border object-cover hairline sm:w-44"
            />
            <div class="space-y-4 leading-relaxed text-ink-soft">
              <p>I'm an application developer with a computer science background and professional experience shipping internal business systems.</p>
              <p>My independent work spans APIs, AI workflows, backend systems, cross-device applications, and native TV software. I care about the whole lifecycle: understanding the problem, building the implementation, operating it, and improving it from real usage.</p>
            </div>
          </div>
        </div>
        <div id="contact" class="reveal scroll-mt-24 border-l pl-6 hairline lg:pl-10">
          <p class="section-kicker">Contact</p>
          <h2 class="mt-3 text-2xl font-semibold text-ink">Let's talk about the work.</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">For engineering roles, contract work, or technical collaboration, email is the fastest way to reach me.</p>
          <div class="mt-6 space-y-3 text-sm">
            <a class="block font-medium text-brand" href="mailto:jaylon@flashaisolutions.org">jaylon@flashaisolutions.org</a>
            <a class="block text-ink-soft" href="https://github.com/iFan6oy">GitHub</a>
            <a class="block text-ink-soft" href="https://www.linkedin.com/in/jaylon-malone-3b306b37/">LinkedIn</a>
            <a class="block text-ink-soft" href={asset('JaylonMalone_Resume.pdf')}>Resume (PDF)</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
